rules_version = '2';

// ============================================================================
// BarberOS — Security Rules
// ============================================================================
// Esta es la ÚNICA barrera real de aislamiento entre barberías. Los filtros del
// frontend (src/hooks/useTenantData.js) son para la UI; cualquiera puede abrir
// la consola y pedirle datos a Firestore directamente. Lo que decide qué ve
// cada uno es este archivo.
//
// El permiso NO se lee de la base: se lee de los CUSTOM CLAIMS del token, que
// solo se pueden escribir desde el servidor (Admin SDK). Si el permiso se
// leyera de un documento, un admin podría editarse su propio documento y
// escalar privilegios.
//
// Claims esperados:
//   { platform: true }                        → dueño de la plataforma (vos)
//   { businessId: 'biz-x', role: 'owner' }    → dueño de una barbería
//   { businessId: 'biz-x', role: 'admin',
//     professionalId: 'prof-y' }              → peluquero: solo sus turnos
//   (sin claims)                              → cliente
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    /** El dueño de la plataforma. Puede todo. */
    function isPlatform() {
      return signedIn() && claims().get('platform', false) == true;
    }

    /**
     * Moderador: el equipo de soporte. Lleva `platform: 'moderator'` y NO
     * `platform: true` a propósito — así todas las reglas que exigen isPlatform()
     * lo dejan afuera por defecto, y lo que puede hacer se le concede acá
     * abajo explícitamente: leer, y atender tickets. Nunca plata, cuentas ni
     * suspensiones.
     */
    function esModerador() {
      return signedIn() && claims().get('platform', false) == 'moderator';
    }

    /** Dueño o moderador: quien puede ENTRAR al panel global. */
    function esEquipoPlataforma() {
      return isPlatform() || esModerador();
    }

    // Pertenece a este negocio (con cualquier rol de staff)
    //
    // Dos formas de pertenecer, y la segunda existe por las cuentas con
    // sucursales (Plan Empresarial): un dueño con varias barberías lleva en el
    // token `businessIds: ['biz-a', 'biz-b', …]` además del `businessId` suelto,
    // que sigue apuntando a la principal porque es lo que entiende el resto del
    // código.
    //
    // Quién escribe esa lista: SOLO las Cloud Functions con el Admin SDK, y la
    // calculan preguntándole a la base qué negocios comparten `grupoId` — un
    // campo que las Rules no le dejan tocar al dueño (ver más abajo). Un barbero
    // nunca lleva `businessIds`: su claim nombra una sola barbería, así que no
    // puede ver la agenda de otra sucursal ni queriendo.
    function inBusiness(bizId) {
      return signedIn() && (
        claims().get('businessId', '') == bizId
        || bizId in claims().get('businessIds', [])
      );
    }

    function isBusinessOwner(bizId) {
      return inBusiness(bizId) && claims().get('role', '') == 'owner';
    }

    function isBusinessStaff(bizId) {
      return inBusiness(bizId) && claims().get('role', '') in ['owner', 'admin'];
    }

    /**
     * Barbero: staff con rol 'admin', atado a un perfil de profesional. A
     * diferencia del dueño, solo alcanza SUS turnos.
     */
    function esBarbero(bizId) {
      return inBusiness(bizId) && claims().get('role', '') == 'admin';
    }

    /** ¿Este turno es del barbero que está llamando? */
    function esSuTurno() {
      return resource.data.professionalId == claims().get('professionalId', '');
    }

    /** ¿Este horario es del barbero que está llamando? */
    function esSuHorario(bizId, datos) {
      return esBarbero(bizId) && datos.professionalId == claims().get('professionalId', '');
    }

    // Escribe cosas del negocio: su dueño, o vos preparando la cuenta.
    function canManage(bizId) {
      return isBusinessOwner(bizId) || isPlatform();
    }

    // ── Capacidades del plan ───────────────────────────────────────────────
    // Qué funciones tiene habilitadas una barbería según lo que paga: foto de
    // perfil del barbero, colores propios, logo propio. Esconder el botón en la
    // interfaz no alcanza — con la consola abierta se escribe igual —, así que
    // el permiso vive acá.
    //
    // Se lee del campo `capacidades` del documento del negocio, que escribe la
    // plataforma al dar de alta o al cambiar de plan (y que el dueño no puede
    // tocar; está en la lista de abajo). No se puede resolver por `planId`
    // porque las Rules no pueden importar la tabla de planes: tendría que estar
    // escrita acá también y sería un cuarto lugar donde desincronizarse.
    //
    // Por defecto TRUE: una cuenta vieja todavía no tiene el campo escrito, y
    // sacarle de un día para el otro la foto que ya tenía cargada sería
    // cambiarle el trato sin avisar. Se migran con scripts/migrar-planes.mjs.
    function capacidadEn(datos, nombre) {
      return datos.get('capacidades', {}).get(nombre, true) == true;
    }

    function capacidadDelNegocio(bizId, nombre) {
      return capacidadEn(get(/databases/$(database)/documents/businesses/$(bizId)).data, nombre);
    }

    // ── Mapa slug → businessId ─────────────────────────────────────────────
    // Lectura pública: el cliente entra por /barberia-x y hay que resolver el
    // slug SIN estar logueado y sin poder listar todos los negocios.
    // Documento: /slugs/{slug} = { businessId: 'biz-x' }
    match /slugs/{slug} {
      allow get: if true;
      allow list: if esEquipoPlataforma();
      allow write: if isPlatform();
    }

    // ── Grupos de sucursales ───────────────────────────────────────────────
    // La lista de barberías de una cuenta empresarial, para que el cliente que
    // entra por el link pueda ELEGIR a qué sucursal va. Es el mismo caso que
    // /slugs: un mapa chiquito y público, porque resolverlo de otra forma
    // obligaría a permitir listar la colección `businesses` — y ahí cualquiera
    // se baja la cartera entera de clientes.
    //
    // Solo guarda ids. El nombre, la dirección y si está suspendida se leen del
    // documento de cada barbería, que ya es público: así la pantalla de
    // "elegí tu sucursal" nunca muestra un dato viejo.
    //
    // `get` y no `list`: se busca por el id del grupo, que sale del documento
    // del negocio. Nadie recorre los grupos.
    match /grupos/{grupoId} {
      allow get: if true;
      allow list: if esEquipoPlataforma();
      // Lo escribe `crearSucursal` con el Admin SDK, que es lo único que sabe
      // cuántas sucursales tiene la cuenta y cuántas permite el plan.
      allow write: if false;
    }

    // ── Negocios ───────────────────────────────────────────────────────────
    // `get` público porque la página de reservas necesita nombre, colores,
    // horarios y mensaje de bienvenida antes del login.
    // OJO: acá NO van datos de facturación. La deuda y el abono viven en
    // /businesses/{id}/private/billing, que no es público. Si los metés en este
    // documento, cualquier cliente los puede leer.
    match /businesses/{bizId} {
      allow get: if true;

      // Nadie lista todos los negocios salvo el panel global.
      allow list: if esEquipoPlataforma();

      // Solo vos das de alta o borrás cuentas: es una operación comercial.
      allow create, delete: if isPlatform();

      // El dueño edita su marca y configuración, pero no puede tocar su propia
      // facturación ni descongelarse solo.
      //
      // `trialEndsAt` está en la lista por una razón concreta: runBilling lo
      // lee de ESTE documento para saber si cobrar. Sin protegerlo, un dueño
      // con la consola abierta se ponía la prueba en 2099 y no pagaba nunca.
      //
      // `grupoId` es más grave todavía, y es el peor agujero posible acá: los
      // claims de una cuenta con sucursales se calculan preguntándole a la base
      // qué negocios tienen ese grupoId. Si el dueño pudiera escribirlo, se
      // pondría el grupoId de OTRA barbería y en el próximo recálculo de
      // permisos se llevaría su negocio adentro de sus claims. Lo escribe solo
      // `crearSucursal` con el Admin SDK.
      //
      // Y los colores y el logo dependen del plan: son las funciones que
      // separan al Full del Básico. Acá no hace falta un get() extra porque el
      // documento que se está escribiendo ES el del negocio: `resource.data` ya
      // trae sus capacidades.
      // El logo va como data URL adentro de ESTE documento (sin Storage, igual
      // que la foto del barbero). Sin tope, un logo pesado se lleva puesto el
      // límite de 1 MB por documento y deja la barbería sin poder guardar nada.
      function logoRazonable() {
        return !('logoUrl' in request.resource.data)
               || request.resource.data.logoUrl == null
               || (request.resource.data.logoUrl is string
                   && request.resource.data.logoUrl.size() < 250000);
      }

      allow update: if logoRazonable() && (isPlatform() || (
        isBusinessOwner(bizId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isFrozen', 'planId', 'monthlyFee', 'whatsappQuota', 'slug', 'id',
                   'trialEndsAt', 'createdAt', 'maxBarbers', 'maxSucursales', 'origen',
                   'mpConectado', 'mpUserId', 'grupoId', 'capacidades',
                   // Membresías: las prende la plataforma, cuenta por cuenta.
                   'membresiasHabilitadas']) &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['primaryColor', 'secondaryColor', 'accentColor'])
         || capacidadEn(resource.data, 'colores')) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['logoUrl'])
         || capacidadEn(resource.data, 'logo')) &&
        // Prender o apagar su página de presentación. El interruptor vive en el
        // documento del negocio —y no adentro de la configuración de la página—
        // para que la ruta pública sepa si tiene que ir a buscarla SIN una
        // lectura de más: el que no la tiene no paga nada.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paginaActiva'])
         || capacidadEn(resource.data, 'pagina'))
      ));

      // ── La página de presentación de la barbería ─────────────────────────
      // Lo que ve el cliente antes de reservar: plantilla, portada y botones.
      //
      // Va en un documento APARTE y no en el del negocio por el peso: el
      // documento del negocio lo lee cada visitante del link Y vive en la
      // suscripción del panel, así que sumarle una imagen de portada sería
      // pagarla en cada pantalla. Acá se baja solo cuando alguien abre la
      // página. Por eso también es `public/` y no `private/`: lo lee cualquiera.
      match /public/pagina {
        allow read: if true;

        // La escribe el dueño, si el plan la incluye. La imagen de portada es
        // otra capacidad (Full): un Intermedio puede tener su página, pero con
        // las plantillas que no llevan foto.
        //
        // `create, update` y no `write`: en un delete `request.resource` es
        // null y preguntarle por `coverUrl` da "Null value error", que cuenta
        // como denegado. El borrado va aparte y sin condiciones sobre el
        // contenido nuevo, porque no hay contenido nuevo.
        allow create, update: if canManage(bizId)
                        && capacidadDelNegocio(bizId, 'pagina')
                        && portadaRazonable()
                        && (!('coverUrl' in request.resource.data)
                            || request.resource.data.coverUrl == null
                            || capacidadDelNegocio(bizId, 'paginaFoto'));

        allow delete: if canManage(bizId);
      }

      // La portada va como data URL adentro de este documento. Sin tope, una
      // imagen pesada se lleva puesto el límite de 1 MB por documento y la
      // página deja de poder guardarse. 400 KB es una foto de 1200 px de ancho
      // bien comprimida, que es todo lo que hace falta para un fondo.
      function portadaRazonable() {
        return !('coverUrl' in request.resource.data)
               || request.resource.data.coverUrl == null
               || (request.resource.data.coverUrl is string
                   && request.resource.data.coverUrl.size() < 400000);
      }

      // Facturación: solo la plataforma. Ni el dueño la lee.
      match /private/billing {
        allow read: if esEquipoPlataforma();
        allow write: if isPlatform();
      }

      // Tokens de Mercado Pago del dueño. Los escribe y los lee SOLO la Cloud
      // Function con el Admin SDK: con el access token de su cuenta se puede
      // cobrar y mover plata, así que no sale al browser ni para el dueño.
      // El panel se entera de si está conectado por `mpConectado`, que vive en
      // el documento público y no sirve para operar.
      match /private/mercadopago {
        allow read, write: if false;
      }

      // ── Staff, catálogo y horarios ───────────────────────────────────────
      // Lectura pública: sin esto la página de reservas no puede mostrar
      // profesionales, servicios ni calcular horarios disponibles.
      //
      // El barbero edita SU ficha desde "Mi Configuración" (nombre, especialidad,
      // bio). Lo que no puede tocar es `isActive`: activarse o desactivarse es
      // del dueño, y además es lo que cuenta para el límite de barberos del
      // plan. Tampoco crea ni borra fichas. Verificado: sin esta rama la página
      // entera del barbero fallaba con permission-denied al guardar.
      // La foto va como data URL adentro del doc (sin Storage): se acota el
      // tamaño para que nadie meta un doc de 1 MB en una colección pública.
      function fotoRazonable() {
        return !('avatarUrl' in request.resource.data)
               || request.resource.data.avatarUrl == null
               || (request.resource.data.avatarUrl is string
                   && request.resource.data.avatarUrl.size() < 250000);
      }

      // La foto de perfil es una función del plan (desde el Intermedio). Si el
      // plan no la tiene, el campo no se puede escribir — ni el dueño ni el
      // barbero desde "Mi Configuración". Solo se chequea cuando la escritura
      // TOCA el campo: si no, cualquier cambio de nombre de un Básico con una
      // foto vieja cargada quedaría bloqueado para siempre.
      function fotoPermitida(bizId) {
        return !('avatarUrl' in request.resource.data)
               || (resource != null
                   && resource.data.get('avatarUrl', null) == request.resource.data.avatarUrl)
               || capacidadDelNegocio(bizId, 'fotoPerfil');
      }

      match /professionals/{profId} {
        allow read: if true;

        // Crear un barbero pasa por la Cloud Function `crearProfesional`, que
        // cuenta los activos y hace cumplir el tope del plan. Las Rules no
        // pueden contar documentos, así que sin la function el tope viviría
        // solo en la interfaz — y "no me deja agregar otro" se saltea con la
        // consola abierta. La plataforma sí crea directo: prepara cuentas.
        allow create: if isPlatform() && fotoRazonable() && fotoPermitida(bizId);

        allow delete: if canManage(bizId);
        allow update: if fotoRazonable()
                         && fotoPermitida(bizId)
                         && (canManage(bizId)
                             || (esBarbero(bizId)
                                 && claims().get('professionalId', '') == profId
                                 && !request.resource.data.diff(resource.data).affectedKeys()
                                       .hasAny(['isActive', 'id'])));
      }

      // Teléfono y mail personales del staff, en subcolección aparte.
      //
      // NO van dentro de /professionals porque ese documento es de lectura
      // pública: la página de reservas necesita nombre, especialidad y foto
      // antes del login. Con el contacto adentro, cualquiera con el link (o
      // adivinando el slug) se bajaba los teléfonos y mails del equipo.
      // Verificado contra el emulador: sin login se leían enteros.
      //
      // El dueño gestiona a todo su equipo; un barbero solo su propia ficha.
      match /staffContacts/{profId} {
        allow read: if isBusinessStaff(bizId) || isPlatform();
        allow write: if canManage(bizId)
                        || (isBusinessStaff(bizId) && claims().get('professionalId', '') == profId);
      }

      match /services/{srvId} {
        allow read: if true;
        allow write: if canManage(bizId);
      }

      // El barbero maneja sus propios horarios (la página los reemplaza
      // enteros: borra los suyos y crea los nuevos). Los de otro, no.
      match /schedules/{schId} {
        allow read: if true;
        allow create: if canManage(bizId) || esSuHorario(bizId, request.resource.data);
        allow update: if canManage(bizId)
                         || (esSuHorario(bizId, resource.data) && esSuHorario(bizId, request.resource.data));
        allow delete: if canManage(bizId) || esSuHorario(bizId, resource.data);
      }

      match /professionalServices/{psId} {
        allow read: if true;
        allow write: if canManage(bizId);
      }

      // ── Membresías ───────────────────────────────────────────────────────
      // Planes mensuales que la barbería le vende a sus clientes. Viven en la
      // barbería PRINCIPAL de la cuenta (se usan en cualquier sucursal).
      //
      // NADIE escribe desde el browser, ni el dueño: el estado lo trae Mercado
      // Pago o lo carga el dueño por las Functions (membresias.js), que validan
      // plan, servicios, fechas y que no haya otra viva. Si el barbero pudiera
      // escribir acá, se terminó el control: se pondría "activa" o se sumaría
      // usos a quien quisiera. Los usos tampoco se pueden editar después: son
      // la auditoría.
      //
      // El barbero no lee nada de esto: lo que necesita ver (que el turno es
      // con membresía) viaja en el snapshot del turno.

      // Los planes son información comercial, como los servicios y sus precios.
      match /membresiaPlanes/{planId} {
        allow read: if true;
        allow write: if false;
      }

      match /membresias/{membresiaId} {
        allow read: if isBusinessOwner(bizId) || esEquipoPlataforma()
                       || (signedIn() && resource.data.clienteUid == request.auth.uid);
        allow write: if false;

        match /periodos/{periodoId} {
          allow read: if isBusinessOwner(bizId) || esEquipoPlataforma();
          allow write: if false;
        }
      }

      match /membresiaUsos/{usoId} {
        allow read: if isBusinessOwner(bizId) || esEquipoPlataforma()
                       || (signedIn() && resource.data.clienteUid == request.auth.uid);
        allow write: if false;
      }

      // Plata que entró por membresías: igual que la facturación, el moderador
      // no la ve.
      match /membresiaPagos/{pagoId} {
        allow read: if isBusinessOwner(bizId) || isPlatform();
        allow write: if false;
      }

      // ── Turnos ───────────────────────────────────────────────────────────
      // El beneficio de la membresía viaja en el turno (`membresia`) y lo
      // escribe SOLO el servidor. Desde el browser no se puede ponerlo, ni
      // sacarlo, ni tocarle al turno con membresía lo que define el beneficio
      // (servicio, precio, de quién es): cambiar el servicio de un turno
      // cubierto por "Corte" a "Corte + barba" sería sacarle al plan algo que
      // no incluye. Fecha, hora y estado sí se tocan: los sigue el trigger
      // onTurnoMembresia (cancelar libera el uso, atender o faltar lo consume).
      function noTocaLaMembresia() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['membresia'])
               && (!('membresia' in resource.data)
                   || !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['serviceId', 'price', 'precioLista', 'userId']));
      }

      match /appointments/{aptId} {
        // El dueño ve toda la agenda; el barbero solo los suyos; el cliente
        // solo los propios.
        allow get: if isBusinessOwner(bizId)
                      || esEquipoPlataforma()
                      || (esBarbero(bizId) && esSuTurno())
                      || (signedIn() && resource.data.userId == request.auth.uid);

        // Listar la agenda completa es solo del staff. El cliente puede listar
        // filtrando por su uid: la query DEBE llevar where('userId','==',uid),
        // si no, Firestore la rechaza.
        //
        // La condición se apoya en resource.data, no en request.query.limit.
        // Con el límite había DOS problemas, los dos verificados contra el
        // emulador:
        //   1. No miraba de quién era el turno. Cualquiera logueado que pusiera
        //      un limit listaba la agenda entera del negocio y se llevaba
        //      nombre, teléfono y horario de todos los clientes.
        //   2. Si la query no traía limit, `request.query.limit` es null y
        //      `null <= 100` es un error de tipos en Rules, que cuenta como
        //      denegado. Como subscribeMyAppointments no pone límite, "Mis
        //      Citas" fallaba para todos los clientes.
        // En un `list`, Firestore evalúa esta condición contra cada documento
        // devuelto y exige que la query garantice que todos la cumplen: el
        // where por userId la satisface, y una query sin filtrar la viola.
        // Al barbero se le aplica el mismo criterio: su query TIENE que llevar
        // where('professionalId','==',suId). Lo hace BusinessSync.
        allow list: if isBusinessOwner(bizId)
                       || esEquipoPlataforma()
                       || (esBarbero(bizId) && esSuTurno())
                       || (signedIn() && resource.data.userId == request.auth.uid);

        // Un cliente NO escribe turnos directo: reserva por la Cloud Function
        // `createAppointment`, que valida precio, fecha, horario, solapamiento y
        // que el negocio no esté suspendido. La función usa el Admin SDK, así
        // que no pasa por acá.
        //
        // El staff sí crea directo, y es a propósito: el panel registra los
        // "servicio sin turno" (walk-in) del que ya está sentado en la silla.
        // Es su propia agenda y sus propios precios.
        //
        // El turno que carga el staff lleva SU uid como userId (quién lo cargó):
        // no puede plantarle un turno a otra cuenta, que lo vería en "Mis citas".
        allow create: if request.resource.data.userId == request.auth.uid
                         && !('membresia' in request.resource.data)
                         && (isPlatform()
                             || isBusinessOwner(bizId)
                             || (esBarbero(bizId)
                                 && request.resource.data.professionalId == claims().get('professionalId', '')));

        // Cancelar: el cliente solo puede cambiar el estado a 'cancelada' de un
        // turno propio. Cambiar fecha, precio o profesional es cosa del staff.
        allow update: if ((isBusinessOwner(bizId)
                           || isPlatform()
                           || (esBarbero(bizId) && esSuTurno()))
                          && noTocaLaMembresia())
                         || (
                              signedIn()
                              && resource.data.userId == request.auth.uid
                              // Solo un turno vivo se cancela: uno completado o
                              // ausente ya cuenta en la caja y las estadísticas.
                              && resource.data.status in ['pendiente', 'confirmada']
                              && request.resource.data.status == 'cancelada'
                              && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['status', 'cancelledAt', 'cancellationReason', 'cancelledBy'])
                            );

        // Los turnos no se borran: se cancelan. Así queda historial.
        allow delete: if false;
      }

      // ── Reseñas ──────────────────────────────────────────────────────────
      // Una por turno, y el id del documento ES el id del turno. No es un
      // detalle de implementación: es lo que hace imposible la segunda reseña
      // del mismo turno sin contar nada ni confiar en el frontend.
      //
      // Lo que se guarda tiene que COINCIDIR con el turno (mismo profesional,
      // mismo servicio, mismo negocio). Si no, una reseña podría quedar
      // colgada del barbero equivocado y ensuciar sus estadísticas para
      // siempre — y eso lo decidiría quien manda el formulario.
      function datosDeLaResena(d) {
        return d.stars is int && d.stars >= 1 && d.stars <= 5
               && (!('comment' in d) || d.comment == null
                   || (d.comment is string && d.comment.size() <= 600));
      }

      function coincideConElTurno(bizId, aptId, d) {
        return esElTurno(get(/databases/$(database)/documents/businesses/$(bizId)/appointments/$(aptId)).data, bizId, aptId, d);
      }

      // Ojo con los parámetros: `aptId` se pasa, NO se toma del match.
      // Esta función vive en el match del NEGOCIO, no en el de /reviews, así que
      // ahí adentro `aptId` no existe — y una variable que no existe en Rules no
      // da error de compilación: revienta en tiempo de ejecución con "Null value
      // error" y la regla entera queda en denegado. Resultado: nadie podía dejar
      // una reseña y el motivo no se veía por ningún lado.
      function esElTurno(t, bizId, aptId, d) {
        return t.userId == request.auth.uid
               // Solo se valora lo que ya pasó Y el barbero marcó como
               // atendido. Un turno pendiente, cancelado o "no vino" no se
               // puede calificar.
               && t.status == 'completada'
               && d.professionalId == t.professionalId
               && d.get('serviceId', null) == t.get('serviceId', null)
               && d.get('businessId', '') == bizId
               && d.get('appointmentId', '') == aptId;
      }

      // ── Cupones de descuento ─────────────────────────────────────────────
      // CERRADOS AL CLIENTE, por completo. Ni leer uno suelto.
      //
      // Es la decisión central de todo esto y conviene no aflojarla después:
      // si un cliente pudiera leer `cupones/CORTE20`, probando códigos
      // encuentra los que andan — y un `list` le entrega la promoción entera de
      // la barbería, incluida la que todavía no salió. Por eso la validación es
      // la function `validarCupon`, que contesta "sirve / no sirve" y nada más,
      // y por eso acá no hay ningún `allow read` para el cliente.
      //
      // Los números (usos, ingresos, clientes nuevos) los escribe el servidor
      // con el Admin SDK, que pasa por arriba de esto. El dueño los lee; no
      // puede editarlos, porque son el resultado de lo que pasó y no un campo.
      match /cupones/{cuponId} {
        allow read: if canManage(bizId);

        // El id del documento ES el código normalizado. Que coincidan no es
        // cosmético: es lo que hace imposible tener dos cupones con el mismo
        // código sin ningún chequeo de unicidad — lo impide Firestore.
        allow create: if canManage(bizId)
                         && cuponValido()
                         && request.resource.data.codigo == cuponId
                         && request.resource.data.get('usos', 0) == 0;

        allow update: if canManage(bizId)
                         && cuponValido()
                         && request.resource.data.codigo == resource.data.codigo
                         // Los contadores son del servidor. Sin esto, el dueño
                         // se pone los usos en 0 y revive un cupón agotado, o
                         // se infla los ingresos del informe.
                         && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['usos', 'usosConfirmados', 'ingresos', 'clientesNuevos']);

        allow delete: if canManage(bizId);

        // Un uso por turno, con el id del turno. Mismo truco que las reseñas:
        // Firestore no deja dos documentos con el mismo id, así que el contador
        // nunca puede contar dos veces el mismo turno.
        //
        // Solo el servidor escribe acá, adentro de la transacción que crea el
        // turno. El dueño lo lee para el detalle del cupón.
        match /usos/{aptId} {
          allow read: if canManage(bizId);
          allow write: if false;
        }
      }

      // Lo que un cupón tiene que cumplir para poder guardarse.
      //
      // No es validación de formulario duplicada: el descuento sale de estos
      // campos y se cobra de verdad. Un porcentaje en 200 o un valor negativo
      // escritos con la consola abierta terminan en un turno a precio cero o en
      // un número imposible, y el recorte del servidor existe justamente porque
      // esto se puede intentar.
      function cuponValido() {
        let d = request.resource.data;
        return d.codigo is string
               && d.codigo.size() >= 3 && d.codigo.size() <= 24
               && d.codigo == d.codigo.upper()
               && d.tipo in ['porcentaje', 'fijo']
               && d.valor is number
               && d.valor > 0
               && (d.tipo != 'porcentaje' || d.valor <= 100)
               && d.activo is bool
               && d.get('maxUsos', 0) is number
               && d.get('maxUsosPorCliente', 0) is number;
      }

      match /reviews/{aptId} {
        // La barbería ve las suyas; el barbero, las de sus turnos; el cliente,
        // la propia (para saber que ya valoró y poder corregirla).
        //
        // El `resource == null` del final no sobra: antes de guardar, la app
        // PREGUNTA si ya existe la reseña de ese turno, para saber si crea o
        // corrige. Leer un documento que no existe hacía reventar la regla
        // (`resource.data` de null es "Null value error", que cuenta como
        // denegado), así que nadie podía dejar su primera reseña. Un documento
        // que no existe no tiene a quién proteger.
        allow get: if isBusinessOwner(bizId)
                      || esEquipoPlataforma()
                      || (signedIn() && resource == null)
                      || (esBarbero(bizId) && resource.data.professionalId == claims().get('professionalId', ''))
                      || (signedIn() && resource.data.userId == request.auth.uid);

        allow list: if isBusinessOwner(bizId)
                       || esEquipoPlataforma()
                       || (esBarbero(bizId) && resource.data.professionalId == claims().get('professionalId', ''))
                       || (signedIn() && resource.data.userId == request.auth.uid);

        allow create: if signedIn()
                         && request.resource.data.userId == request.auth.uid
                         && datosDeLaResena(request.resource.data)
                         && coincideConElTurno(bizId, aptId, request.resource.data);

        // Corregirla sí; duplicarla no (el id es el del turno) y cambiar de
        // quién es, tampoco.
        allow update: if signedIn()
                         && resource.data.userId == request.auth.uid
                         && datosDeLaResena(request.resource.data)
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['stars', 'comment', 'updatedAt']);

        // Una reseña no se borra: el promedio de la barbería no se maquilla
        // sacando las malas.
        allow delete: if false;
      }

      // ── Notificaciones al staff ──────────────────────────────────────────
      // Las escribe un trigger de Functions (Admin SDK, no pasa por acá).
      // El dueño ve todas; el barbero las de sus turnos (la query TIENE que
      // filtrar por professionalId, igual que la agenda). Lo único que se
      // edita desde el browser es `leidaPor`, para marcar leída.
      match /notifications/{notifId} {
        // (Antes había un segundo match para esta misma ruta, pensado como log
        // de WhatsApp, que le daba lectura a todo el staff. Dos match sobre la
        // misma ruta se suman: con cualquiera que permita, pasa. Quedó uno.)
        allow get, list: if isBusinessOwner(bizId)
                            || esEquipoPlataforma()
                            || (esBarbero(bizId) && esSuTurno());
        // La plataforma ve estas notificaciones cuando entra al panel de una
        // barbería, así que también tiene que poder marcarlas leídas: si no,
        // "marcar todas" fallaba con permission-denied y volvían a aparecer
        // sin leer (22/09/2026). Solo toca `leidaPor`, como todos.
        allow update: if (isBusinessOwner(bizId) || esEquipoPlataforma() || (esBarbero(bizId) && esSuTurno()))
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidaPor']);
        allow create, delete: if false;
      }

      // ── Dispositivos con push ────────────────────────────────────────────
      // Cada miembro del staff registra SUS dispositivos (uid propio). Los lee
      // el trigger de Functions con el Admin SDK, no el browser: un token de
      // FCM sirve para mandarle mensajes a ese teléfono, no es para compartir.
      match /devices/{token} {
        allow get: if isBusinessStaff(bizId) && resource.data.uid == request.auth.uid;
        allow list: if false;
        allow create, update: if isBusinessStaff(bizId)
                                 && request.resource.data.uid == request.auth.uid;
        allow delete: if isBusinessStaff(bizId) && resource.data.uid == request.auth.uid;
      }

      // ── Admins del negocio ───────────────────────────────────────────────
      // Este documento es un REGISTRO para la UI, no la fuente del permiso.
      // El permiso real son los custom claims, que se asignan con la Cloud
      // Function `setBusinessAdmin`. Se puede escribir acá sin que eso otorgue
      // acceso por sí solo.
      match /admins/{adminId} {
        allow read: if isBusinessStaff(bizId) || esEquipoPlataforma();
        allow write: if canManage(bizId);
      }
    }

    // ── Tickets de soporte ─────────────────────────────────────────────────
    // Colección de primer nivel (no subcolección del negocio) para que el panel
    // global pueda listarlos todos con una query simple, sin collectionGroup ni
    // el índice que eso exige.
    //
    // Cada barbería solo ve los suyos. La regla de `list` compara contra
    // `resource.data.businessId`, así que la query del cliente TIENE que llevar
    // where('businessId','==',suId) — si no, Firestore rechaza toda la consulta.
    match /tickets/{ticketId} {
      allow get: if esEquipoPlataforma() || inBusiness(resource.data.businessId);
      // inBusiness y no la comparación suelta: una cuenta con sucursales abre
      // tickets desde cualquiera de ellas y las tiene que poder ver todas.
      allow list: if esEquipoPlataforma()
                     || (signedIn() && inBusiness(resource.data.businessId));

      // Lo abre la barbería (o vos en su nombre, al preparar la cuenta).
      //
      // El `!= ''` no sobra, y menos ahora que la pertenencia pasa por
      // inBusiness(): el default de claims().get() para alguien SIN claim es la
      // cadena vacía, así que un cliente cualquiera mandando businessId: ''
      // cumpliría la igualdad de adentro de inBusiness y podría crear tickets
      // basura. Se compara contra el dato que llega, no contra el claim.
      allow create: if esEquipoPlataforma()
                       || (signedIn()
                           && request.resource.data.businessId is string
                           && request.resource.data.businessId != ''
                           && inBusiness(request.resource.data.businessId));

      // Cerrar, reabrir, marcar leído. Nadie borra tickets: quedan de historial.
      allow update: if esEquipoPlataforma() || inBusiness(resource.data.businessId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if esEquipoPlataforma()
                       || inBusiness(get(/databases/$(database)/documents/tickets/$(ticketId)).data.businessId);

        // El autor no se acepta del cliente: se compara contra su propio uid.
        //
        // getAfter y no get: el ticket y su primer mensaje se escriben en un
        // mismo batch, y get() ve el estado ANTERIOR al batch — el ticket
        // todavía no existe, .data es null y la regla revienta. Así nadie podía
        // abrir un ticket, dueño incluido; el barbero fue el primero en
        // avisar. getAfter ve el estado como quedaría si el batch entra.
        allow create: if signedIn()
                         && request.resource.data.authorId == request.auth.uid
                         && (esEquipoPlataforma()
                             || inBusiness(getAfter(/databases/$(database)/documents/tickets/$(ticketId)).data.businessId));

        // Un mensaje enviado no se edita ni se borra.
        allow update, delete: if false;
      }
    }

    // ── Usuarios ───────────────────────────────────────────────────────────
    // Cada uno su propio documento. Nadie lista la tabla de usuarios.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isPlatform());
      allow list: if isPlatform();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isPlatform();
    }

    // ── Configuración global de la plataforma ──────────────────────────────
    // Credenciales de WhatsApp y afines. El token NUNCA se guarda acá: va como
    // secret de las Cloud Functions. Ver FIREBASE_SETUP.md.
    match /platform/{docId} {
      allow read, write: if isPlatform();
    }

    // Notificaciones del panel global (tickets, suspensiones). Las escribe un
    // trigger; el equipo de la plataforma las lee y marca leídas.
    // ── Avisos de la plataforma para TODAS las barberías ───────────────────
    // "Actualizamos esto, tenés que hacer aquello". Los escribe solo la
    // plataforma; los lee cualquiera del staff, de cualquier negocio, porque
    // el mensaje es el mismo para todos. No hay nada sensible acá: es lo que
    // hasta ahora se mandaba por WhatsApp uno por uno.
    match /platform/avisos/items/{avisoId} {
      allow read: if signedIn();
      allow write: if isPlatform();
    }

    // ── Cobros de la plataforma ────────────────────────────────────────────
    // Un asiento por cada pago que registra el panel global: con esto se puede
    // decir cuánto facturó BarberOS este mes y los anteriores. Antes solo
    // quedaba `lastPaymentDate` en la facturación del negocio, que se pisa en
    // cada cobro.
    //
    // Es plata, así que no sale del equipo de la plataforma. El dueño de la
    // barbería no lo ve ni para sus propios pagos — igual que /private/billing.
    match /platform/cobros/items/{cobroId} {
      allow read: if esEquipoPlataforma();
      allow create, update, delete: if isPlatform();
    }

    match /platform/notifications/items/{notifId} {
      allow read: if esEquipoPlataforma();
      allow update: if esEquipoPlataforma()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidaPor']);
      allow create, delete: if false;
    }

    // Teléfonos del equipo de la plataforma con push. Cada uno los suyos.
    match /platformDevices/{token} {
      allow get: if esEquipoPlataforma() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update: if esEquipoPlataforma() && request.resource.data.uid == request.auth.uid;
      allow delete: if esEquipoPlataforma() && resource.data.uid == request.auth.uid;
    }

    // Equipo de la plataforma (moderadores). Lo escribe solo la Cloud Function
    // setPlatformModerator con el Admin SDK; el panel lo lee para listar.
    match /platform/team/members/{email} {
      allow read: if esEquipoPlataforma();
      allow write: if false;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
